{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "C:/ProgramData/fastfetch/sun.txt",
    "type": "none",
    "color": {
      "1":"#ffa601",
      "2":"#ff9601",
      "3":"#ff8401",
      "4":"#ff7301",
      "5":"#ff5a01"
    },
    "padding": {
      "top": 4,
      "left": 2,
      "right": 4
    }
  },
  "display": {
    "bar": {
      "char": {
        "total": "▢"
      },
      "width": 5
    },
    "percent": {
      "type": 3,
      "ndigits": 2
    },
    "key": {
      "width": 16
    },
    "color": "blink_",
    "separator": " "
  },
  "modules": [
    "break",
    {
      "type": "title",
      "key": "Tawantong Wongrinyong",
      "keyWidth": 23,
      "keyColor": "cyan",
      "format": "{#36}{1} | {2}"
    },
    {
      "type": "datetime",
      "key": " ",
      "format": "{9} / {23} / {6} / {1} {14}:{18}:{20} | THAILAND"
    },
    "break",
    {
      "type": "custom",
      "key": "╭─ System ───┬────────────────────────────────────────╮",
      "keyColor": "green"
    },
    {
      "type": "host",
      "key": "├── PC       │                                        │",
      "keyColor": "green"
    },

    {
      "type": "os",
      "key": "├── OS       │                                        │",
      "keyColor": "green",
      "format": "{3} "
    },

    {
      "type": "packages",
      "key": "├── Packages │                                        │",
      "keyColor": "green"
    },
    {
      "type": "uptime",
      "key": "├── Uptime   │                                        │",
      "keyColor": "green"
    },
    {
      "type": "custom",
      "key": "╰────────────┴────────────────────────────────────────╯",
      "keyColor": "green"
    },
    {
      "type": "custom",
      "key": "╭─ Terminal ─┬────────────────────────────────────────╮",
      "keyColor": "#FF9601"
    },
    {
      "type": "shell",
      "key": "├── Shell    │                                        │",
      "keyColor": "#FF9601"
    },
    {
      "type": "terminal",
      "key": "├── Terminal │                                        │",
      "keyColor": "#FF9601"
    },
    {
      "type": "terminalfont",
      "key": "├── Font     │                                        │",
      "keyColor": "#FF9601"
    },
    {
      "type": "terminalsize",
      "key": "├── Size     │                                        │",
      "keyColor": "#FF9601",
      "format": "{1} colums × {2} rows ({3}px × {4}px)"
    },
    {
      "type": "custom",
      "key": "╰────────────┴────────────────────────────────────────╯",
      "keyColor": "#FF9601"
    },
    {
      "type": "custom",
      "key": "╭─ Hardware ─┬────────────────────────────────────────────╮",
      "keyColor": "red"
    },
    {
      "type": "display",
      "key": "├── Display  │                                            │",
      "keyColor": "red",
      // "format": "{1}×{2}, {3}Hz [{7}] ",
      "format": "{1}×{2}, {3}Hz [{6}]"
    },
    {
      "type": "cpu",
      "key": "├── CPU      │                                            │",
      "keyColor": "red",
      "format": "Intel(R) Core(TM) i5-1240P [{3} cores]"
    },

    {
      "type": "gpu",
      "key": "├── GPU      │                                            │",
      "keyColor": "red",
      "format": "{2}"
    },
    {
      "type": "memory",
      "key": "├── RAM      │                                            │",
      "keyColor": "red"
    },
    {
      "type": "disk",
      "key": "├── Disk     │                                            │",
      "keyColor": "red",
      "format": "{13} {1} / {2} ({3})"
    },
    {
      "type": "battery",
      "key": "├── Battery  │                                            │",
      "keyColor": "red",
      "format": "{10} {4} ({5})"
    },
    {
      "type": "custom",
      "key": "╰────────────┴────────────────────────────────────────────╯",
      "keyColor": "red"
    },
    {
      "type": "colors",
      "key": "╭─ Media ────┬────────────────────────────────────────╮",
      "keyColor": "blue",
      "symbol": "diamond"
    },
    {
      "type": "media",
      "key": "├── Playing  │                                        │",
      "keyColor": "blue",
      "format": "\"{1:36}\""
    },
    // {
    //   "type": "media",
    //   "key": "├── Playing  │",
    //   "keyColor": "blue",
    //   "format": "\"{1}\" - {#1}{3}{#}"
    // },
    {
      "type": "sound",
      "key": "├── Sound    │                                        │",
      "keyColor": "blue",
      "format": "{2:20} {5} {3}"
    },
    {
      "type": "custom",
      "key": "╰────────────┴────────────────────────────────────────╯",
      "keyColor": "blue"
    }
  ]
}